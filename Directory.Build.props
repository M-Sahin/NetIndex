<Project>
  <!-- Shared build properties for all projects -->
  
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Package metadata -->
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/M-Sahin/NetIndex</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/M-Sahin/NetIndex</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Murat</Authors>
    <Version>0.9.1</Version>
    <Description>NetIndex - LlamaIndex for .NET, enterprise-first RAG framework</Description>
  </PropertyGroup>

  <!-- xunit.runner.json for all test projects -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Content Include="..\..\xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
