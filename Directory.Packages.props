<Project>
  <!-- Central Package Management -->
  
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="0.1.0-preview.1" />
    <PackageVersion Include="Microsoft.Extensions.VectorData" Version="0.1.0-preview.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.0" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageVersion Include="xunit" Version="2.7.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageVersion Include="NSubstitute" Version="4.4.0" />
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />

    <!-- Source linking -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />

    <!-- Diagnostics & Analysis -->
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="9.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" />
    <PackageVersion Include="AsyncFixer" Version="1.6.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.9.28" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- SQLite vector store -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.5" />
    <PackageVersion Include="sqlite-vec" Version="0.1.7-alpha.2.1" />

    <!-- pgvector storage -->
    <PackageVersion Include="Npgsql" Version="9.0.3" />
    <PackageVersion Include="Pgvector" Version="0.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />

    <!-- OllamaSharp for Ollama provider -->
    <PackageVersion Include="OllamaSharp" Version="5.0.1" />

    <!-- Azure OpenAI provider -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.3" />

    <!-- PDF ingestion -->
    <PackageVersion Include="PdfPig" Version="0.1.14" />

    <!-- Tesseract OCR ingestion -->
    <PackageVersion Include="TesseractOCR" Version="5.5.2" />
    <PackageVersion Include="PDFtoImage" Version="5.2.1" />

    <!-- DOCX and Markdown ingestion -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />

    <!-- OpenTelemetry host-wiring (AspNetCore integration only — keep off Core packages) -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />

    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.13.12" />

    <!-- Property-based testing -->
    <PackageVersion Include="FsCheck" Version="2.16.6" />
    <PackageVersion Include="FsCheck.Xunit" Version="2.16.6" />
  </ItemGroup>
</Project>
