<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <ProjectReference Include="../../Core/NetIndex.Core.Abstractions/NetIndex.Core.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NetIndex.Providers.AzureOpenAI.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <Title>NetIndex Azure OpenAI Provider</Title>
    <Description>Azure OpenAI embedding and chat-completion provider for NetIndex, with managed-identity support, retry logic, and activity tracing.</Description>
    <PackageTags>rag;netindex;azure;openai;embedding;chat;llm</PackageTags>
  </PropertyGroup>
</Project>
