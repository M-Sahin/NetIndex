<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/NetIndex.Core.Abstractions/NetIndex.Core.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Title>NetIndex OpenAI Provider</Title>
    <Description>OpenAI embedding and chat-completion provider for NetIndex, supporting gpt-4o and text-embedding-3 model families.</Description>
    <PackageTags>rag;netindex;openai;embedding;chat;llm</PackageTags>
  </PropertyGroup>
</Project>
