<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <Title>NetIndex Core Abstractions</Title>
    <Description>Core contracts and interfaces for the NetIndex RAG framework, including IEmbeddingGenerator, IVectorStore, IChatClient, and ITenantResolver.</Description>
    <PackageTags>rag;netindex;core;abstractions</PackageTags>
  </PropertyGroup>
</Project>
