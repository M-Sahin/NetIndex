<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- NetIndex core packages -->
    <PackageReference Include="NetIndex.Core" Version="NETINDEX_PKG_VERSION" />
    <PackageReference Include="NetIndex.AspNetCore" Version="NETINDEX_PKG_VERSION" />

    <!-- Enterprise path: Azure OpenAI + pgvector (active by default) -->
    <PackageReference Include="NetIndex.Providers.AzureOpenAI" Version="NETINDEX_PKG_VERSION" />
    <PackageReference Include="NetIndex.Storage.Pgvector" Version="NETINDEX_PKG_VERSION" />

    <!-- Local dev path: Ollama + SQLite (swap block, commented out by default) -->
    <PackageReference Include="NetIndex.Providers.Ollama" Version="NETINDEX_PKG_VERSION" />
    <PackageReference Include="NetIndex.Storage.Sqlite" Version="NETINDEX_PKG_VERSION" />
  </ItemGroup>

</Project>
