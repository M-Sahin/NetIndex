{
  "$schema": "http://json.schemastore.org/template",
  "author": "Murat",
  "classifications": ["Web", "RAG", "AI"],
  "identity": "NetIndex.Template",
  "name": "NetIndex Enterprise RAG (Azure OpenAI + pgvector)",
  "shortName": "netindex",
  "sourceName": "NetIndex.Template",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "NetIndexVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.9.1",
      "replaces": "NETINDEX_PKG_VERSION",
      "description": "The version of NetIndex packages to reference in the scaffolded project. Defaults to 0.9.1; the release pipeline overrides this to the published version at pack time."
    }
  }
}
